{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/session-init.sh",
            "timeout": 3
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/forge-update-check.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/architect-gate.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/commit-validator.sh",
            "timeout": 5,
            "if": "Bash(git commit:*)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/command-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/db-guard.sh",
            "timeout": 5,
            "if": "Bash(psql:*) || Bash(mysql:*) || Bash(sqlite3:*) || Bash(mongosh:*)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Grep|WebFetch|BashOutput",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/secret-filter.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/context-guardian.sh exitplan",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/context-guardian.sh precompact"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/backup-transcript.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "backend-development@claude-code-workflows": true,
    "documentation-generation@claude-code-workflows": true,
    "debugging-toolkit@claude-code-workflows": true,
    "frontend-mobile-development@claude-code-workflows": true,
    "full-stack-orchestration@claude-code-workflows": true,
    "tdd-workflows@claude-code-workflows": true,
    "code-refactoring@claude-code-workflows": true,
    "dependency-management@claude-code-workflows": true,
    "error-debugging@claude-code-workflows": true,
    "javascript-typescript@claude-code-workflows": true,
    "cicd-automation@claude-code-workflows": true,
    "context7@claude-plugins-official": true,
    "cloud-infrastructure@claude-code-workflows": true,
    "hr-legal-compliance@claude-code-workflows": true,
    "database-design@claude-code-workflows": true,
    "startup-business-analyst@claude-code-workflows": true,
    "comprehensive-review@claude-code-workflows": true,
    "frontend-design@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true
}
