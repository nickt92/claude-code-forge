  "presets": {
    "ask-before-changes": {
      "label": "Ask Before Changes",
      "tier": 1,
      "description": "Claude browses your code without asking, but asks permission before making any changes.",
      "detail": "Auto-approves: reading files, searching code, inspecting directories and git history, system info. You approve: file edits, running any command that modifies state.",
      "default_mode": "default",
      "_allow_doc": {
        "removed": [
          "Bash(env:*), Bash(printenv:*) - a whole-environment dump is credentials,",
          "not browsing. Bash(open:*), Bash(xdg-open:*) - these launch applications,",
          "which is execution; they moved to tier 3. Bash(command:*) - `command` is a",
          "wrapper Claude Code already strips before matching, so the rule bought",
          "nothing while allowing `command rm -rf /`; replaced by Bash(command -v:*).",
          "Bash(codesign -v:*) - -v is codesign's VERBOSE flag as well as a prefix of",
          "--verify, so it signed binaries from the read-only tier."
        ],
        "git_read": [
          "Read-only plumbing the 1.x list missed. git grep, git check-ignore and",
          "git ls-tree alone accounted for 89 prompts in one user's history."
        ],
        "no_pager": [
          "A global flag before the subcommand defeats every Bash(git <verb>:*) rule,",
          "because prefix matching is literal. `git --no-pager diff` is the form",
          "Claude reaches for when it wants unpaged output."
        ]
      },
      "allow": [
