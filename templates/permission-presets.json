    "auto-edit": {
      "label": "Auto-Edit",
      "tier": 2,
      "description": "Claude browses and edits files without asking. Still asks before running dev tools and git operations.",
      "detail": "Auto-approves: everything above, plus creating/editing/copying/moving files. You approve: build commands, test runners, git commits/pushes.",
      "inherits": "ask-before-changes",
      "default_mode": "acceptEdits",
      "_allow_doc": {
        "assets": [
          "File-producing tools that showed up repeatedly in real sessions and have",
          "no destructive mode worth gating."
        ],
        "interpreters": [
          "awk and sed can execute (awk 'BEGIN{system(...)}'), so tier 2 is not a",
          "no-execution tier. It is 'Claude may edit files and use the tools that",
          "edit files'. The banned-wrapper invariant deliberately does not list",
          "them - see the note on tier 3."
        ]
      },
      "allow": [
        "Write",
        "Edit",
        "NotebookEdit",
        "TaskStop",
        "Bash(mkdir:*)",
        "Bash(touch:*)",
        "Bash(cp:*)",
        "Bash(mv:*)",
        "Bash(chmod:*)",
        "Bash(ln:*)",
        "Bash(sed:*)",
        "Bash(awk:*)",
