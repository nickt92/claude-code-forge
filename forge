#!/bin/bash
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# forge — CLI for Claude Code Forge
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Dispatcher that routes subcommands to lib/cmd-*.sh modules.
#
# Usage:
#   forge <subcommand> [args]
#   forge install [--profile X] [--plugins group] [--quiet]
#   forge switch <persona>
#   forge doctor
#   forge update
#   forge diff
#   forge build
#   forge init [--persona X]
#   forge version
#   forge help

set -euo pipefail

# Resolve source directory from this script's real location (follows symlinks)
_resolve_forge_source() {
  local source="$0"
  while [ -L "$source" ]; do
    local dir
    dir="$(cd "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    # Resolve relative symlinks
    [[ "$source" != /* ]] && source="$dir/$source"
  done
  cd "$(dirname "$source")" && pwd
}

FORGE_SOURCE_DIR="$(_resolve_forge_source)"
export FORGE_SOURCE_DIR

# Core env vars used by all modules
CLAUDE_DIR="${CLAUDE_DIR:-$HOME/.claude}"
SECTIONS_DIR="$FORGE_SOURCE_DIR/templates/sections"
PROFILES_DIR="$FORGE_SOURCE_DIR/templates/profiles"
export CLAUDE_DIR SECTIONS_DIR PROFILES_DIR

# Source UI first (needed by all commands)
source "$FORGE_SOURCE_DIR/lib/ui.sh"

# ── Subcommand dispatch ──────────────────────────────────────

cmd_version() {
  source "$FORGE_SOURCE_DIR/lib/manifest.sh"
  echo "forge $FORGE_VERSION"
}

cmd_help() {
  source "$FORGE_SOURCE_DIR/lib/manifest.sh"

  printf "\n"
  printf "${_C_BOLD}forge${_C_RST} ${_C_DIM}v%s${_C_RST} — persona-driven configuration for Claude Code\n" "$FORGE_VERSION"
  printf "\n"
  printf "${_C_BOLD}Usage:${_C_RST}  forge ${_C_DIM}<command>${_C_RST} [options]\n"

  printf "\n${_C_BOLD}Setup${_C_RST}\n"
  printf "  ${_C_BOLD}install${_C_RST}     Install or reinstall forge to ~/.claude/\n"
  printf "  ${_C_BOLD}build${_C_RST}       Create a custom persona profile\n"
  printf "  ${_C_BOLD}init${_C_RST}        Initialize per-project forge config\n"

  printf "\n${_C_BOLD}Management${_C_RST}\n"
  printf "  ${_C_BOLD}switch${_C_RST}      Switch to a different persona\n"
  printf "  ${_C_BOLD}update${_C_RST}      Update forge from source repository\n"

  printf "\n${_C_BOLD}Diagnostics${_C_RST}\n"
  printf "  ${_C_BOLD}status${_C_RST}      Show current installation status\n"
  printf "  ${_C_BOLD}stats${_C_RST}       Show installation statistics\n"
  printf "  ${_C_BOLD}doctor${_C_RST}      Run diagnostic health checks\n"
  printf "  ${_C_BOLD}dashboard${_C_RST}   Configuration health dashboard (JSON)\n"
  printf "  ${_C_BOLD}diff${_C_RST}        Show differences between source and installed\n"
  printf "  ${_C_BOLD}export${_C_RST}      Package installation into portable archive\n"

  printf "\n${_C_BOLD}Configuration${_C_RST}\n"
  printf "  ${_C_BOLD}config${_C_RST}      Get/set forge settings\n"
  printf "  ${_C_BOLD}permissions${_C_RST} Manage Claude Code permission presets\n"

  printf "\n${_C_BOLD}Info${_C_RST}\n"
  printf "  ${_C_BOLD}statusline${_C_RST}  Interactive status line legend\n"
  printf "  ${_C_BOLD}version${_C_RST}     Show forge version\n"
  printf "  ${_C_BOLD}help${_C_RST}        Show this help\n"

  # Show current status if installed
  if [ -f "$CLAUDE_DIR/profile.json" ] 2>/dev/null; then
    local persona label plugin_group
    persona=$(jq -r '.persona // "unknown"' "$CLAUDE_DIR/profile.json" 2>/dev/null)
    label=$(jq -r '.label // .persona // "unknown"' "$CLAUDE_DIR/profile.json" 2>/dev/null)
    if [ -f "${MANIFEST_FILE:-$CLAUDE_DIR/forge-manifest.json}" ]; then
      plugin_group=$(jq -r '.plugin_group // "full"' "${MANIFEST_FILE:-$CLAUDE_DIR/forge-manifest.json}" 2>/dev/null)
    else
      plugin_group="unknown"
    fi
    printf "\n${_C_DIM}Active: %s (%s plugins)${_C_RST}\n" "$label" "$plugin_group"
  fi

  printf "\n${_C_DIM}Run forge <command> --help for command-specific options.${_C_RST}\n"
}

# Auto-discover available commands from lib/cmd-*.sh files
_forge_available_commands() {
  for f in "$FORGE_SOURCE_DIR/lib/cmd-"*.sh; do
    [ -f "$f" ] || continue
    local name
    name="$(basename "$f" .sh)"
    echo "${name#cmd-}"
  done
}

# Main dispatch
main() {
  local subcmd="${1:-help}"
  shift 2>/dev/null || true

  case "$subcmd" in
    version|--version|-v)
      cmd_version
      return
      ;;
    help|--help|-h)
      cmd_help
      return
      ;;
  esac

  local cmd_file="$FORGE_SOURCE_DIR/lib/cmd-${subcmd}.sh"
  if [ ! -f "$cmd_file" ]; then
    fail "Unknown command: $subcmd"
    echo ""
    echo "Available commands:"
    while IFS= read -r cmd; do
      echo "  $cmd"
    done < <(_forge_available_commands)
    echo "  version"
    echo "  help"
    exit 1
  fi

  source "$cmd_file"
  "cmd_${subcmd}" "$@"
}

main "$@"
